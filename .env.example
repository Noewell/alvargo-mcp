# Alvargo MCP Gateway — independent alvargo.net deployment
#
# This service is a thin public MCP gateway. It does not own Firebase, Stripe,
# AI-provider, shipper-key, or payment secrets; those stay in Alvargo-LaaSv1.

# Only required when running the standalone Node process outside Netlify.
PORT=3001

# Authoritative platform endpoint. The gateway forwards tool calls here.
MAIN_APP_URL=https://alvargo.delivery

# Public URL of this separately deployed MCP gateway.
MCP_PUBLIC_URL=https://alvargo.net
