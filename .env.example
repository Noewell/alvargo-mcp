# Alvargo MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# Port the MCP server listens on (default: 3001)
PORT=3001

# URL of the main Alvargo platform (alvargo.delivery)
# All authenticated tool calls are proxied to this URL
MAIN_APP_URL=https://alvargo.delivery

# Optional: Override the MCP server's own public URL (used in status responses)
# MCP_PUBLIC_URL=https://alvargo.net
